# Express Backend Port
PORT=4076

# Database Configuration
DATABASE="stage"
DATABASE_URL=postgres://postgres:admin@localhost:5432/mathematador_app
STAGE_DATABASE_URL=postgres://postgres:admin@localhost:5432/mathematador_app
NO_DATABASE_SSL="yes"

# JWT Token Secret
JWT_SECRET="secret"

# Google OAuth Client ID (Web application type) - used only to verify the
# `aud` claim on Google ID tokens from "Sign in with Google"; not a secret.
GOOGLE_CLIENT_ID=""
