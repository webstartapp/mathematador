# Expo/Metro Dev Server Port (this is the actual env var Expo's CLI reads
# natively as its port fallback - see @expo/cli's resolveOptions.js)
RCT_METRO_PORT=4075

# Backend API base URL - inlined into the client bundle at build time. Only
# the port from this value matters for a physical device running Expo Go
# in dev over LAN - api-client.ts derives the actual host from
# Constants.expoConfig.hostUri there instead (the host:port the device
# already used to fetch the JS bundle from Metro), since "localhost" would
# resolve to the device itself, not this machine. This does NOT apply to a
# phone's web browser: hostUri is only populated for a native Expo Go/dev
# client connection, not a plain web page, so this value is used as-is
# there too (same as web on this machine, and any production build).
EXPO_PUBLIC_API_URL="http://localhost:4076"

# Disable React Navigation compatibility check for Expo SDK 56
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1

# Google OAuth Client ID (Web application type, from Google Cloud Console) -
# inlined into the client bundle at build time; not a secret.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=""
