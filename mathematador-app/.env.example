# Expo/Metro Dev Server Port (this is the actual env var Expo's CLI reads
# natively as its port fallback - see @expo/cli's resolveOptions.js)
RCT_METRO_PORT=4075

# Backend API base URL - inlined into the client bundle at build time
EXPO_PUBLIC_API_URL="http://localhost:4076"

# Disable React Navigation compatibility check for Expo SDK 56
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
