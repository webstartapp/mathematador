{
  "name": "mathematador-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "mathematador-app",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace=server && npm run build --workspace=mathematador-app",
    "test": "npm test --workspace=server -- --watchAll=false && npm test --workspace=mathematador-app -- --watchAll=false",
    "lint": "eslint .",
    "generate": "orval",
    "verify": "node agents/verify.js",
    "push": "git push"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "expo-constants": "~57.0.16",
    "expo-router": "~57.0.17",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "orval": "^8.17.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "glob": "^13.0.6",
    "jest-environment-jsdom": "^30.4.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.17",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "decode-uri-component": "^0.5.0",
    "babel-plugin-istanbul": {
      "test-exclude": "^8.0.0"
    }
  }
}
