{
  "name": "mathematador-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "mathematador-app",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace=server && npm run build --workspace=mathematador-app",
    "test": "npm test --workspace=server -- --watchAll=false && npm test --workspace=mathematador-app -- --watchAll=false",
    "lint": "eslint .",
    "generate:api": "orval",
    "generate": "orval"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "eslint": "^9.21.0",
    "typescript": "^6.0.3",
    "orval": "^8.17.0",
    "zod": "^4.4.3",
    "@typescript-eslint/parser": "^8.61.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "typescript-eslint": "^8.61.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-config-prettier": "^10.0.2",
    "globals": "^16.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "glob": "^13.0.6",
    "jest-environment-jsdom": "^30.4.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.17"
  }
}
