{
  "name": "mathematador-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "mathematador-app",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace=server && npm run build --workspace=mathematador-app",
    "test": "npm test --workspace=server -- --watchAll=false && npm test --workspace=mathematador-app -- --watchAll=false",
    "lint": "eslint .",
    "generate": "orval",
    "verify": "node agents/verify.js",
    "push": "git push"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "orval": "^8.17.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "glob": "^13.0.6",
    "jest-environment-jsdom": "^30.4.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.17",
    "body-parser": "^2.2.3",
    "brace-expansion": "^2.1.4",
    "fast-uri": "^3.1.5",
    "image-size": "^1.2.1",
    "js-yaml": "^4.3.1",
    "linkify-it": "^5.0.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "shell-quote": "^1.8.2",
    "tar": "^7.5.21",
    "undici": "^6.28.0"
  }
}
