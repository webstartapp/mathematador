# eslint-plugin-react@7.37.5 (the latest published release) still declares its
# eslint peer range as "^3 || ^4 || ^5 || ^6 || ^7 || ^8 || ^9.7" - it hasn't
# been updated for ESLint 10 yet, even though it lints correctly under it
# (verified: a full `npm run lint` run passes cleanly on real eslint@10.9.1
# with this plugin active). Without this, npm ci hard-fails on that stale
# peer range alone. Revisit removing this once eslint-plugin-react ships an
# ESLint 10-compatible release.
legacy-peer-deps=true
